{
  "expo": {
    "name": "Patel de Batata",
    "slug": "patel-de-batata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5C118"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pateldebatata.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSAppleMusicUsageDescription": "Patel de Batata precisa de acesso à biblioteca de música para reproduzir as tuas músicas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5C118"
      },
      "package": "com.pateldebatata.app",
      "minSdkVersion": 24,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ]
    },
    "owner": "dianaz",
    "extra": {
      "eas": {
        "projectId": "d1069bb7-3a1a-4ce5-b50f-392a4d7778bc"
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Patel de Batata precisa de acesso às tuas músicas.",
          "savePhotosPermission": "Permite guardar alterações nos ficheiros de áudio.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
